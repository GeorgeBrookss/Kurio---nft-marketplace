# Ativa a camada MSW (REST + Socket.IO). Obrigatório no build de demonstração.
VITE_ENABLE_MOCKS=true
# Base das APIs REST (interceptadas pelo MSW)
VITE_API_URL=/api
# Endpoint Socket.IO (interceptado pelo MSW via @mswjs/socket.io-binding)
VITE_SOCKET_URL=wss://realtime.kurio.mock
# Timeout do Axios em ms (usado no cenário de timeout de pedido)
VITE_HTTP_TIMEOUT=8000
